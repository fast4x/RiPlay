<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema fijo oscuro (Encore). Ya no sigue el modo claro/oscuro del sistema. -->
    <style name="Theme.RiPlay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:enforceStatusBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>
        <item name="android:windowBackground">@color/encore_background</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/encore_green</item>
    </style>
</resources>
